# OPENAI (server-side only — never expose to the browser)
# Required for BLOOM AI chat support (/api/ai/chat) and personalized quests (/api/ai/quest).
OPENAI_API_KEY=replace_with_server_side_key
OPENAI_MODEL=gpt-5

# Optional legacy Gemini endpoints (check-in solution / insight explain). Not used for urge chat.
# GEMINI_API_KEY: Required for Gemini AI API calls on non-chat routes.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION:
# Set your Supabase Project URL and Anon API key to enable cross-device authentication and sync
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# FEATURE FLAGS:
# Bloom Analytics — weekly + monthly insights + rule-based Health Quest recommendations
# true | false  (default: disabled if unset)
VITE_FEATURE_BLOOM_ANALYTICS=false
# Explainable AI narrative before recommendations (defaults to ON when Bloom Analytics is enabled)
# Set false to hide the XAI explain block
VITE_FEATURE_INSIGHTS_XAI=true
